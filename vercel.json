{
  "installCommand": "npm install && composer install --working-dir=api/streak --no-dev --optimize-autoloader",
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/streak/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/streak", "destination": "/api/streak/index.php" },
    { "source": "/streak/", "destination": "/api/streak/index.php" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://github.com/JamesWJager/github-readme-stats"
    }
  ]
}
