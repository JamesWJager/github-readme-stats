{
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/streak/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "api/streak/**"
    }
  },
  "rewrites": [
    { "source": "/streak", "destination": "/api/streak/index.php" },
    { "source": "/streak/", "destination": "/api/streak/index.php" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://github.com/JamesWJager/github-readme-stats"
    }
  ]
}
